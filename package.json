{
  "name": "@canshift/core",
  "version": "13.7.0",
  "description": "CANShift shared configuration domain types, schemas, and validation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ecu-profiles": {
      "types": "./dist/entries/ecu-profiles.d.ts",
      "import": "./dist/entries/ecu-profiles.js",
      "default": "./dist/entries/ecu-profiles.js"
    },
    "./schema-version": {
      "types": "./dist/entries/schema-version.d.ts",
      "import": "./dist/entries/schema-version.js",
      "default": "./dist/entries/schema-version.js"
    },
    "./tokens": {
      "types": "./dist/entries/tokens.d.ts",
      "import": "./dist/entries/tokens.js",
      "default": "./dist/entries/tokens.js"
    },
    "./track": {
      "types": "./dist/entries/track.d.ts",
      "import": "./dist/entries/track.js",
      "default": "./dist/entries/track.js"
    },
    "./widget-metrics": {
      "types": "./dist/entries/widget-metrics.d.ts",
      "import": "./dist/entries/widget-metrics.js",
      "default": "./dist/entries/widget-metrics.js"
    },
    "./wire": {
      "types": "./dist/entries/wire.d.ts",
      "import": "./dist/entries/wire.js",
      "default": "./dist/entries/wire.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "export:sensor-defaults": "npm run build && node --experimental-strip-types scripts/export-sensor-defaults.ts",
    "prepare": "husky",
    "lint:pre-commit": "lint-staged"
  },
  "keywords": [
    "canshift",
    "dashboard",
    "can-bus",
    "config",
    "schema"
  ],
  "author": "TMBK",
  "license": "UNLICENSED",
  "private": false,
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CANShift/canshift-core.git"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml,yaml}": "prettier --write --ignore-unknown",
    "*.ts": "eslint --fix --no-warn-ignored"
  }
}
